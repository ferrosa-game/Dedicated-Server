package ferrosa:plugin@0.1.0;

interface types {
    type player-id = u32;

    type body-id = u32;

    type human-id = u32;
    type item-id = u32;
    type vehicle-id = u32;

    enum team {
        goldmen,
        monsota,
        oxs,
        nexaco,
        pentacom,
        prodocon,
        mission,
        spectator,
    }

    /// The game's menus.
    enum menu {
        empty,
        enter-city,
        lobby,
        empty-base,
        world-car-shop,
        world-store,
        world-store-done,
        world-bank,
        world-bank2,
        round-corp-weapons,
        round-corp-ammo,
        round-corp-equip,
        round-corp-vehicle,
        round-corp-stock,
        world-empty-corp,
        world-corp-application,
        world-corp-tabs,
        world-corp-hiring,
        world-corp-firing,
        world-corp-team,
        world-corp-requisition,
    }

    /// A human's health, each part out of 100.
    record health {
        /// Overall health: at 49 or less the human falls down.
        health: s32,
        blood: s32,
        /// Whether it is alive: dead at 0 or less, weakened at 24 or less, and a bandage saves it at 9 or less.
        vitality: s32,
        chest: s32,
        head: s32,
        left-arm: s32,
        right-arm: s32,
        left-leg: s32,
        right-leg: s32,
    }

    /// What is hurting a human, and who is behind it.
    variant damage-cause {
        /// A bullet, and the player who fired it.
        bullet(option<player-id>),
        /// A grenade, and the player who primed it.
        explosion(option<player-id>),
        /// Hitting the ground or a wall hard.
        fall,
        /// Run over, and the vehicle's last driver.
        vehicle(option<player-id>),
    }

    /// A human's bones.
    enum bone {
        pelvis,
        stomach,
        torso,
        head,
        shoulder-left,
        forearm-left,
        hand-left,
        shoulder-right,
        forearm-right,
        hand-right,
        thigh-left,
        shin-left,
        foot-left,
        thigh-right,
        shin-right,
        foot-right,
    }

    /// A player's gender, which picks their body, head and hair models.
    enum gender {
        female,
        male,
    }

    /// What a player wears.
    enum model {
        casual,
        suit,
        /// The second suit, which mission bots and guards wear.
        suit2,
    }

    /// The colours a suit comes in.
    enum suit-colour {
        brown,
        black,
        grey,
        navy,
        teal,
        purple,
        tan,
        white,
        red,
        indigo,
        dark-navy,
        dark-grey,
    }

    /// A player, bots included. Every call reads or changes the real player; once they have left they read as an
    /// empty spectator and changes do nothing.
    resource player {
        id: func() -> player-id;
        /// False once the player has left.
        exists: func() -> bool;
        name: func() -> string;
        /// Shown to everyone; a bot's can be blank.
        set-name: func(name: string);
        team: func() -> team;
        /// Puts them on `team`. Their look stays as it is.
        set-team: func(team: team);
        /// Whether they're ready in the lobby.
        ready: func() -> bool;
        set-ready: func(ready: bool);
        /// Whether they see the manager page (menu 19) of their corporation's base.
        manager-tab: func() -> bool;
        set-manager-tab: func(on: bool);
        /// The account they joined with; none for a bot.
        account-id: func() -> option<u32>;
        /// Their next human has it.
        gender: func() -> gender;
        set-gender: func(gender: gender);
        /// Their look, and their human's with it: what they wear, the suit's and tie's colours and the necklace (0
        /// none).
        model: func() -> model;
        set-model: func(model: model);
        suit-colour: func() -> suit-colour;
        set-suit-colour: func(colour: suit-colour);
        tie-colour: func() -> u8;
        set-tie-colour: func(colour: u8);
        necklace: func() -> u8;
        set-necklace: func(necklace: u8);
        /// Ticks until they may switch team again; 0 lets them.
        team-switch-timer: func() -> s32;
        set-team-switch-timer: func(ticks: s32);
        admin: func() -> bool;
        bot: func() -> bool;
        /// A message only this player sees. Long messages and line breaks become several chat lines.
        message: func(message: string);
        /// The client's mission event, which eliminator's HUD shows, to this player alone. `kind` 0 tells them their
        /// role (`role` 0 target, 1 eliminator, 2 protector, with `value` their id << 10 plus the target's), 1 a
        /// position to show (`pos`), 2 a group's result at the end (`role` the group, `value` the eliminator << 10
        /// plus the target plus the protector << 20).
        send-mission-event: func(kind: s32, role: s32, value: s32, pos: option<vec3>);
        human: func() -> option<human>;
        /// Makes them control `human`.
        set-human: func(human: borrow<human>);
        money: func() -> s32;
        /// Sets their money and tells their client.
        set-money: func(money: s32);
        /// The shares they hold in their corporation.
        stocks: func() -> s32;
        /// Sets the shares they hold, and tells their client. Their corporation's share count stays as it is.
        set-stocks: func(stocks: s32);
        /// Buys `count` shares in their corporation (never past 9999 held) if they have more money than they cost, and
        /// tells their client.
        buy-stocks: func(count: s32);
        /// Sells `count` of their shares if they hold that many, at the share of the price server.set-stock-sell-rate
        /// set (95% unless a mode changed it), less what the corporation's running missions were given per share, and
        /// tells their client.
        sell-stocks: func(count: s32);
        /// Sells every share they hold the same way; nothing for a player in no corporation.
        sell-all-stocks: func();
        /// Takes a bot off the server; false for a real player, who can only be kicked.
        remove: func() -> bool;
        /// The route a bot walks, from the first point, round and round.
        set-waypoints: func(waypoints: list<vec3>);
        god-mode: func() -> bool;
        set-god-mode: func(on: bool);
        /// The menu they have open.
        menu: func() -> menu;
        set-menu: func(menu: menu);
        /// A button on their open menu, for this tick: the server sends the menu's buttons each tick, so add them
        /// from menus-done. `extra` is the number shown with it, such as a price; none keeps that slot's last one.
        add-menu-button: func(id: s32, text: string, extra: option<s32>);
        camera: func() -> vec3;
        yaw: func() -> f32;
        pitch: func() -> f32;
        /// The way they face along the ground: their view turned by its yaw alone. -x is ahead and -z to the right.
        facing: func() -> mat3;
        /// The way they look: their view turned by its yaw, then its pitch. -x is where they look.
        view: func() -> mat3;
    }

    /// A corporation: its share market, base and missions. Every call reads or changes the real one.
    resource corporation {
        team: func() -> team;
        /// Its base on the map; none if the map has none for it.
        base: func() -> option<base>;
        /// A vehicle in the first free car space of its base; none when they're all taken.
        spawn-vehicle: func(kind: u32, colour: s32) -> option<vehicle>;
        funds: func() -> s32;
        set-funds: func(funds: s32);
        /// Its 16 mission slots.
        missions: func() -> list<mission>;
        /// Sets a mission slot and tells the corporation's clients.
        set-mission: func(slot: u32, mission: mission);
        /// The shares its members hold, plus what the market keeps.
        shares: func() -> s32;
        set-shares: func(shares: s32);
        price: func() -> f32;
        /// Sets a share's price, and sends every client the prices.
        set-price: func(price: f32);
    }

    /// A rigid body: a bone of a human, an item, or a vehicle's chassis or wheel. Every call reads or changes the real
    /// body; once it has been removed it reads as still at the origin and changes do nothing. Velocities are per tick.
    resource body {
        id: func() -> body-id;
        /// False once the body has been removed.
        exists: func() -> bool;
        pos: func() -> vec3;
        set-pos: func(pos: vec3);
        vel: func() -> vec3;
        set-vel: func(vel: vec3);
        ang-vel: func() -> vec3;
        set-ang-vel: func(ang-vel: vec3);
        mass: func() -> f32;
        /// Resting, so the physics leaves it alone until something wakes it.
        settled: func() -> bool;
        /// A push of `impulse` at `offset` from its centre.
        add-impulse: func(offset: vec3, impulse: vec3);
    }

    /// A human, controlled by a player or nobody. Every call reads or changes the real human; once it has been
    /// removed it reads as dead and changes do nothing.
    resource human {
        id: func() -> human-id;
        /// False once the human has been removed.
        exists: func() -> bool;
        pos: func() -> vec3;
        /// 0 or less is dead.
        vitality: func() -> s32;
        /// A hit of `damage` on one of its bones, as a bullet's: the torso loses chest health, the head head health,
        /// arms and legs more; any hit may start bleeding. It isn't passed to on-damage.
        damage: func(bone: bone, damage: s32);
        health: func() -> health;
        /// Sets every part of its health at once. A mortal human dies on its next update with no blood left (10 or
        /// less) or no chest or head health.
        set-health: func(health: health);
        set-vitality: func(vitality: s32);
        bleeding: func() -> bool;
        set-bleeding: func(bleeding: bool);
        player: func() -> option<player-id>;
        /// The vehicle it's in.
        vehicle: func() -> option<vehicle>;
        /// Puts it in one of `vehicle`'s seats, 0 the driver's; false if the vehicle is gone.
        enter-vehicle: func(vehicle: borrow<vehicle>, seat: u32) -> bool;
        /// Its bones' bodies.
        bones: func() -> list<body>;
        set-view-yaw: func(yaw: f32);
        /// A new item of `kind` into the first free slot from `first` up to but not `end`: 0 and 1 are the hands, 2
        /// to 6 the pockets. None if it didn't fit.
        give-item: func(kind: u32, first: u32, end: u32) -> option<item>;
        /// What one slot holds.
        slot: func(slot: u32) -> list<item>;
        /// Puts `item` into one of its slots, with whatever is there already.
        put-item: func(item: borrow<item>, slot: u32);
        delete: func();
    }

    /// An item in the world or carried. Every call reads or changes the real item; once it has been removed it reads
    /// as nowhere and changes do nothing.
    resource item {
        id: func() -> item-id;
        /// False once the item has been removed.
        exists: func() -> bool;
        /// Its kind's number, as item-kinds lists them.
        kind: func() -> u32;
        pos: func() -> vec3;
        /// A phone's number; none if it isn't a phone.
        phone-number: func() -> option<s32>;
        /// False if it isn't a phone.
        set-phone-number: func(number: s32) -> bool;
        /// Which of the two phone textures it shows; false if it isn't a phone.
        set-phone-texture: func(texture: s32) -> bool;
        /// The vehicle a key opens; false if it isn't a key.
        set-key-vehicle: func(vehicle: option<borrow<vehicle>>) -> bool;
        /// Puts `child` inside it, such as a disk in a briefcase (open or closed) or a magazine in a gun; false if it
        /// can't go there.
        attach: func(child: borrow<item>) -> bool;
        /// What's inside it. Deleting an item drops these.
        children: func() -> list<item>;
        /// The human whose hands or pockets it's in; none for an item lying in the world (or inside another).
        holder: func() -> option<human>;
        body: func() -> option<body>;
        /// What's left in it: a gun's chambered rounds, a magazine's rounds, a grenade's or bandage's uses.
        uses: func() -> s32;
        set-uses: func(uses: s32);
        /// The vehicle a key opens.
        key-vehicle: func() -> option<vehicle>;
        /// A bundle of cash's bills; none if it isn't cash.
        cash: func() -> option<cash>;
        /// False if it isn't cash.
        set-cash: func(cash: cash) -> bool;
        /// The computer inside it; none if it isn't a computer.
        computer: func() -> option<computer>;
        /// The volume a disk holds; none if it isn't a disk.
        volume: func() -> option<volume>;
        /// Gives a disk or a computer the volume it reads, as server.new-volume makes them; false for any other
        /// item. A computer spawned outside a building has none until it is given one.
        set-volume: func(volume: borrow<volume>) -> bool;
        /// Takes it out of the world; an item of a set goes back where the set keeps it.
        delete: func();
    }

    /// A vehicle. Every call reads or changes the real vehicle; once it has been removed it reads as nowhere and
    /// changes do nothing.
    resource vehicle {
        id: func() -> vehicle-id;
        /// False once the vehicle has been removed.
        exists: func() -> bool;
        /// Its kind's number, as vehicle-kinds lists them.
        kind: func() -> u32;
        colour: func() -> s32;
        /// 0 or less is wrecked.
        health: func() -> s32;
        rot: func() -> mat3;
        /// Its chassis's body.
        body: func() -> option<body>;
        /// Its wheels' bodies.
        wheels: func() -> list<body>;
        pos: func() -> vec3;
        /// Makes it a parked traffic car, which bots can drive.
        park-in-traffic: func();
        /// Takes it out of the world, getting anyone in it out first.
        delete: func();
    }

    record mat3 {
        x: vec3,
        y: vec3,
        z: vec3,
    }

    /// A corporation's base: the box inside it (one floor high), its vault, the table, where players spawn and the
    /// spaces its cars appear in.
    record base {
        interior-min: vec3,
        interior-max: vec3,
        vault-min: vec3,
        vault-max: vec3,
        /// The way the table faces, in radians about the up axis.
        table-orientation: f32,
        table: vec3,
        spawn: vec3,
        car-spaces: list<car-space>,
    }

    /// A bundle of cash: how many bills, and each bill's code (three bits apiece).
    record cash {
        bills: s32,
        codes: u32,
    }

    /// A street intersection.
    record intersection {
        /// Its position on the road.
        pos: vec3,
        /// How far the streets around it reach east, south, west and north, in grid units.
        lanes: tuple<s32, s32, s32, s32>,
        /// The box its road covers.
        min: vec3,
        max: vec3,
    }

    /// Where a vehicle's origin goes in a base.
    record car-space {
        pos: vec3,
        rot: mat3,
    }

    /// One of a corporation's missions.
    record mission {
        active: bool,
        /// Set once the mission is decided.
        done: bool,
        /// The deal it belongs to, shared by the corporations of one deal.
        id: s32,
        /// 1 acquisition by car chase, 2 sell a disk, 3 buy it, 4 buy it unfunded, 7 two-team sellers, 8 their buyer.
        kind: s32,
        /// The disks of the deal; -1 for none.
        item: s32,
        item2: s32,
        /// The other corporations of the deal.
        team1: s32,
        team2: s32,
        disk-type: s32,
        value: s32,
        /// The world clock the mission runs until.
        deadline: s32,
        /// The mission spot the disk waits at, or -1 for the table.
        location: s32,
        provided-cash: s32,
        rate: f32,
    }

    /// The kinds of message send-chat sends.
    enum chat-type {
        /// Said by a human, heard around it: `speaker` is the human.
        chat,
        /// Said by an item, such as a phone: `speaker` is the item.
        item-speak,
        /// Eliminator's announcement line.
        eliminator-announcement,
        /// Seen only by admins.
        admin-chat,
        /// Put in the game's notice line rather than the chat.
        notice,
    }

    record vec3 {
        x: f32,
        y: f32,
        z: f32,
    }

    /// The current state of the game, physics only ticks on in-game
    enum game-state {
        idle,
        intermission,
        in-game,
        restarting,
        paused,
    }

    /// The game's own modes. Clients only know these.
    enum client-mode {
        driving,
        racing,
        round,
        %world,
        eliminator,
        coop,
        versus,
        none,
    }

    /// What a computer is running.
    enum computer-mode {
        shell,
        decrypt,
        mission,
        /// A plugin's own program.
        plugin,
    }

    /// The sixteen colours a computer screen draws in: the PC text palette, in its own order, which is also the
    /// number each one has in a line's colours.
    enum screen-shade {
        black,
        blue,
        green,
        cyan,
        red,
        magenta,
        brown,
        light-grey,
        dark-grey,
        bright-blue,
        bright-green,
        bright-cyan,
        bright-red,
        bright-magenta,
        yellow,
        white,
    }

    /// A character's colours on a computer screen.
    record screen-colour {
        foreground: screen-shade,
        background: screen-shade,
    }

    /// The screen and shell inside a computer item. Every call reads or changes the real computer; once the item is
    /// gone, or is not a computer, it reads as a blank screen and changes do nothing.
    resource computer {
        /// The item it belongs to.
        item: func() -> item-id;
        /// False once the item has been removed, or is no longer a computer.
        exists: func() -> bool;
        /// The player typing on it: whoever holds it. None for one lying in the world.
        holder: func() -> option<player>;
        /// The corporation whose base it is in; none outside a base.
        team: func() -> option<team>;
        mode: func() -> computer-mode;
        /// The plugin program it is running; none in any other mode.
        program: func() -> option<string>;

        /// A line of output on the current line, which then scrolls as the shell's own does. Past 62 characters is
        /// cut.
        print: func(text: string);
        /// Writes `text` across line `line` in `colour`, the rest of the line spaces: for a program drawing a whole
        /// screen. The screen keeps 24 lines but only ever draws the first 23, so line 23 is never seen, and
        /// nothing past it is written at all.
        write-line: func(line: u32, text: string, colour: screen-colour);
        /// The same across the first `width` columns only, as the game's own list screens highlight a row. The
        /// line ends at `width`, so nothing is drawn past it; 62 columns is the whole line.
        write-field: func(line: u32, text: string, width: u32, colour: screen-colour);
        /// Writes `text` on line `line` with its own colour for each character, for a program drawing a picture
        /// rather than a row of text: `colours` covers as many columns as it has, and a column past the end of
        /// `text` is a space.
        write-cells: func(line: u32, text: string, colours: list<screen-colour>);
        /// What line `line` holds.
        read-line: func(line: u32) -> option<string>;
        /// The 24 lines a program draws on blanked.
        clear: func();
        /// The cursor's line (0 to 22, as far as the screen is drawn) and column (0 to 62); none hides it, as a
        /// program does.
        set-cursor: func(at: option<tuple<u32, u32>>);
        /// Ends the program running on it, giving the shell back. A program can end itself this way from its tick
        /// as well as by refusing a key.
        exit: func();

        /// The volume a drive reads: 0 the disk in it, 2 its own. None for a drive that isn't ready.
        drive-volume: func(drive: u32) -> option<volume>;
    }

    /// A file system volume: a disk's, or a computer's own.
    resource volume {
        id: func() -> u32;
        /// How much it holds: a disk 360, a computer 10000.
        capacity: func() -> s32;
        /// Every file on it. Files are never taken away, so a file keeps its place for as long as the volume lives.
        files: func() -> list<file>;
        /// A new file holding `text`; none once the volume holds 256 files, or the 8192 file contents are all
        /// taken. Directories are only ever read, never made, so it goes in the root.
        add-file: func(name: string, text: string) -> option<file>;
    }

    resource file {
        /// Cut to 15 characters, as the shell stores it.
        name: func() -> string;
        /// Its text, enciphered or not: a plugin reads through the cipher.
        text: func() -> string;
        set-text: func(text: string);
        /// Whether DECRYPT must be run on it to read it in game.
        encrypted: func() -> bool;
        /// Enciphers it with a fresh cipher, or leaves it plain.
        set-encrypted: func(encrypted: bool);
    }
}
