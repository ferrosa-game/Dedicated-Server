package ferrosa:plugin@0.1.0;

/// Every hook. A plugin's own world only needs `import server` and the hooks it uses, such as:
///
/// world my-plugin {
///     import ferrosa:plugin/server@0.1.0;
///     export ferrosa:plugin/on-chat@0.1.0;
/// }
///
/// A plugin can read and write files in its own folder (the one holding its plugin.toml) through WASI, with paths
/// relative to it, such as `std::fs::read_to_string("config.toml")`. Nothing outside the folder can be opened.
world plugin {
    import server;

    export init;
    export on-start;
    export reset;
    export tick;
    export tick-after-traffic;
    export before-physics;
    export after-physics;
    export menus-done;
    export on-menu;
    export on-chat;
    export on-join;
    export on-leave;
    export on-death;
    export on-hurt;
    export on-admin-select;
}
