package ferrosa:plugin@0.1.0;

// Every hook is its own interface, and a plugin exports only the ones it uses: the server calls whichever it finds.

/// Once, when the plugin is loaded, before the server starts. A plugin that is a game mode calls server.register-mode
/// here; nothing else in server can be used yet.
interface init {
    init: func();
}

/// Once, when the server starts.
interface on-start {
    on-start: func();
}

/// A reset, after the corporations' missions are cleared.
interface reset {
    reset: func();
}

/// Each server tick (60 a second), whatever the game state: after the players' input and menus (menus-done has
/// run), before the traffic and NPCs move. The mode is called first, then each plugin. Traffic asked for here with
/// server.set-traffic is made this tick.
interface tick {
    tick: func();
}

/// Each server tick, after the traffic cars and NPCs have moved (they only move in game), and before the players'
/// own simulation and the physics. The mode is called first, then each plugin.
interface tick-after-traffic {
    tick-after-traffic: func();
}

interface before-physics {
    before-physics: func();
}

interface after-physics {
    after-physics: func();
}

interface menus-done {
    menus-done: func();
}

/// Each player's menus for the tick, once the shops and banks have had theirs. `outside` is where their human
/// stands when it is in no shop or bank, and none when it is in one, so a mode leaves those menus alone. Only asked
/// of the mode.
interface base-menus {
    use types.{player-id, vec3};

    base-menus: func(player: player-id, outside: option<vec3>);
}

/// What a joining player's money is, given what their account holds. Only asked of the mode.
interface joining-money {
    joining-money: func(money: s32) -> s32;
}

/// A menu button pressed; true takes it. The mode is asked first, then each plugin, then the shared menus.
interface on-menu {
    use types.{menu, player-id};

    on-menu: func(player: player-id, menu: menu, button: u32) -> bool;
}

/// A chat message from a player, before the server's own commands; true takes it, and it goes no further. The mode is
/// asked first, then each plugin. /admin messages never reach plugins.
interface on-chat {
    use types.{player-id};

    on-chat: func(player: player-id, message: string) -> bool;
}

/// A player has joined, their account restored and the initial sync sent: where a mode sets their starting money.
interface on-join {
    use types.{player-id};

    on-join: func(player: player-id);
}

/// One player has hurt another: where a mode scores it. The damage is what landed, except for a grenade or a
/// run-over, which both come as 100.
interface on-hurt {
    use types.{player-id};

    on-hurt: func(attacker: player-id, victim: player-id, damage: s32);
}

/// A player has left
interface on-leave {
    use types.{player-id};

    on-leave: func(player: player-id);
}

/// A real player's human has died.
interface on-death {
    use types.{player-id};

    on-death: func(player: player-id);
}

/// A human is about to be hurt by a bullet, a grenade, a fall or a vehicle; returns the damage to deal instead (0 to
/// refuse it). The mode is asked first, then each plugin with the last answer. For a bullet `damage` is the hit's, as
/// human.damage deals it, and its scoring (criminal rating) follows the answer; otherwise it is the vitality the hit
/// takes (a grenade all of it, a fall or a run-over 120), or for a fall on a thigh the leg's health. Admin kills and
/// the criminal-rating kick aren't asked about.
interface on-damage {
    use types.{bone, damage-cause, human-id};

    on-damage: func(human: human-id, cause: damage-cause, bone: option<bone>, damage: s32) -> s32;
}

/// /resetgame has named this plugin's mode. Only asked of the mode.
interface on-admin-select {
    on-admin-select: func();
}
